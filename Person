class Person:
    def __init__(self, name, age, country):
        self.name = name
        self.age = age
        self.country = country

    def __str__(self):
        return f"{self.name} is {self.age} years old and is from {self.country}."

    def can_vote(self):
        return self.age >= 18


# Create Person instances
person_1 = Person("Juliana", 20, "Canada")
person_2 = Person("Fabian", 25, "Spain")

# Test the output
print(person_1)
print(person_2)

print(person_1.can_vote())
print(person_2.can_vote())
